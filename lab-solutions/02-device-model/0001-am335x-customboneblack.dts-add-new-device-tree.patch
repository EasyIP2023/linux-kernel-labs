From 21965111db74f472d8b8b5fa993eaf8c8e2551da Mon Sep 17 00:00:00 2001
From: Vincent Davis Jr <vince@underview.tech>
Date: Thu, 9 Oct 2025 21:31:04 -0400
Subject: [PATCH] am335x-customboneblack.dts: add new device tree

Add device tree for Wii Nunchuk.

Signed-off-by: Vincent Davis Jr <vince@underview.tech>
---
 arch/arm/boot/dts/ti/omap/Makefile                 |  3 ++-
 .../boot/dts/ti/omap/am335x-customboneblack.dts    | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/boot/dts/ti/omap/am335x-customboneblack.dts

diff --git a/arch/arm/boot/dts/ti/omap/Makefile b/arch/arm/boot/dts/ti/omap/Makefile
index 95c68135dd0c..7a5b997dbaad 100644
--- a/arch/arm/boot/dts/ti/omap/Makefile
+++ b/arch/arm/boot/dts/ti/omap/Makefile
@@ -119,7 +119,8 @@ dtb-$(CONFIG_SOC_AM33XX) += \
 	am335x-sbc-t335.dtb \
 	am335x-sl50.dtb \
 	am335x-wega-rdk.dtb \
-	am335x-osd3358-sm-red.dtb
+	am335x-osd3358-sm-red.dtb \
+	am335x-customboneblack.dtb
 dtb-$(CONFIG_SOC_AM43XX) += \
 	am43x-epos-evm.dtb \
 	am437x-cm-t43.dtb \
diff --git a/arch/arm/boot/dts/ti/omap/am335x-customboneblack.dts b/arch/arm/boot/dts/ti/omap/am335x-customboneblack.dts
new file mode 100644
index 000000000000..f1bc3cf23c81
--- /dev/null
+++ b/arch/arm/boot/dts/ti/omap/am335x-customboneblack.dts
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+
+#include "am335x-boneblack.dts"
+
+&i2c1 {
+ 	status = "okay";
+	clock-frequency = <100000>;
+
+	nunchuk: joystick@52 {
+		compatible = "nintendo,nunchuk";
+		reg = <0x52>;
+	};
+};
-- 
2.43.0

